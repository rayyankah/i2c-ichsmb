[
 {
  "name": "realtime: thermd at 30 wakes up in 99% of periods while hog spins at 20",
  "mode": "irq",
  "machines": ["q35"],
  "shell": "/tmp/thermd -q -P 30 -t 6 >/tmp/th.out 2>&1 & sleep 1; /tmp/hog -p 20 -t 4 >/dev/null; wait; grep RESULT /tmp/th.out",
  "expect": [
   "RESULT periods=600 missed=\\d+ skipped=[0-6] .*"
  ],
  "show": true
 },
 {
  "name": "realtime: thermd at 10 loses at least 100 periods while hog spins at 20",
  "mode": "irq",
  "machines": ["q35"],
  "shell": "/tmp/thermd -q -P 10 -t 6 >/tmp/th.out 2>&1 & sleep 1; /tmp/hog -p 20 -t 4 >/dev/null; wait; grep RESULT /tmp/th.out",
  "expect": [
   "RESULT periods=600 missed=[1-9]\\d\\d+ skipped=[1-9]\\d\\d+ .*"
  ],
  "show": true
 },
 {
  "name": "realtime: same in polling mode, thermd at 30 wakes up in 99% of periods",
  "mode": "poll",
  "shell": "/tmp/thermd -q -P 30 -t 6 >/tmp/th.out 2>&1 & sleep 1; /tmp/hog -p 20 -t 4 >/dev/null; wait; grep RESULT /tmp/th.out",
  "expect": [
   "RESULT periods=600 missed=\\d+ skipped=[0-6] .*"
  ],
  "show": true
 }
]
