# SPDX-License-Identifier: Apache-2.0
#
# Bench settings, read by bench/bench. Each one can be overridden from the
# environment, e.g. MACHINE=pc bench/bench up

QNX_ENV=${QNX_ENV:-$HOME/qnx800/qnxsdp-env.sh}   # QNX SDP 8.0 environment script
IMAGE=${IMAGE:-$HOME/work/qnx-image}             # where mkqnximage builds the image
QEMU=${QEMU:-$HOME/work/qemu/bin/qemu-system-x86_64}   # from bench/qemu/build-qemu.sh
MACHINE=${MACHINE:-q35}                          # q35 (ICH9 SMBus) or pc (PIIX4)
SENSORS=${SENSORS-0x48 0x49}                     # tmp105 sensors: QMP ids temp0, temp1, ...
SSH_PORT=${SSH_PORT:-2222}                       # host port forwarded to the guest's SSH
SSH_KEY=${SSH_KEY:-$HOME/.ssh/id_ed25519}        # key installed into the image
# Options for i2c-ichsmb after up. q35: interrupt 16 (QEMU routes the SMBus to I/O APIC input 16,
# but the image's PCI server has no routing entry for it). pc: PIIX4 is polling only.
if [ "$MACHINE" = q35 ]; then DRIVER_OPTS=${DRIVER_OPTS--I 16}; else DRIVER_OPTS=${DRIVER_OPTS-}; fi

export QNX_ENV IMAGE QEMU MACHINE SENSORS SSH_PORT SSH_KEY DRIVER_OPTS
